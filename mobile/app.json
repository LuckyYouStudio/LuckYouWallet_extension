{
  "expo": {
    "name": "LuckYou Wallet",
    "slug": "luckyou-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luckyoustudio.wallet",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your wallet and approve transactions."
      },
      "appleTeamId": "JU4P42JZ54"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0d14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luckyoustudio.wallet"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use Face ID to unlock your wallet and approve transactions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your wallet and approve transactions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0b0d14"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "luckyou",
    "backgroundColor": "#0b0d14",
    "experiments": {
      "typedRoutes": true
    }
  }
}
